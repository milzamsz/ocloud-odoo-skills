<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ocloud_minimal_item_list" model="ir.ui.view">
        <field name="name">ocloud.minimal.item.list</field>
        <field name="model">ocloud.minimal.item</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="quantity"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_ocloud_minimal_item_form" model="ir.ui.view">
        <field name="name">ocloud.minimal.item.form</field>
        <field name="model">ocloud.minimal.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="quantity"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ocloud_minimal_item" model="ir.actions.act_window">
        <field name="name">Minimal Items</field>
        <field name="res_model">ocloud.minimal.item</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_ocloud_minimal_root" name="OCloud Fixtures" groups="base.group_user"/>
    <menuitem
        id="menu_ocloud_minimal_item"
        name="Minimal Items"
        parent="menu_ocloud_minimal_root"
        action="action_ocloud_minimal_item"
        groups="base.group_user"
    />
</odoo>
